<Project>
  <PropertyGroup>
    <!-- Lets the pins below override vulnerable transitive versions. -->
    <CentralPackageTransitivePinningEnabled>true</CentralPackageTransitivePinningEnabled>
  </PropertyGroup>
  <!-- All NuGet versions are pinned here. Versions and licenses verified 2026-10-25
       (see specs/001-project-foundation/research.md). -->
  <ItemGroup Label="Application">
    <PackageVersion Include="Mediator.Abstractions" Version="3.0.2" />
    <PackageVersion Include="Mediator.SourceGenerator" Version="3.0.2" />
    <PackageVersion Include="Riok.Mapperly" Version="4.3.1" />
    <PackageVersion Include="FluentValidation" Version="12.2.0" />
    <PackageVersion Include="FluentValidation.DependencyInjectionExtensions" Version="12.2.0" />
  </ItemGroup>
  <ItemGroup Label="Infrastructure">
    <PackageVersion Include="Microsoft.EntityFrameworkCore.SqlServer" Version="10.0.13" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.13" />
    <PackageVersion Include="Microsoft.Extensions.Diagnostics.HealthChecks" Version="10.0.13" />
    <PackageVersion Include="Microsoft.Extensions.Options.ConfigurationExtensions" Version="10.0.13" />
    <PackageVersion Include="Dapper" Version="2.1.89" />
    <!-- Pinned to the version EF Core 10.0.13 is built against; see research.md 1.3. -->
    <PackageVersion Include="Microsoft.Data.SqlClient" Version="6.1.7" />
    <PackageVersion Include="Microsoft.SqlServer.TransactSql.ScriptDom" Version="180.140.0" />
  </ItemGroup>
  <ItemGroup Label="Security pins (transitive)">
    <!-- Microsoft.Data.SqlClient 6.1.7 depends on 9.0.11, which has advisories
         GHSA-2fmv-rv2c-59x7 and GHSA-846f-f764-76mx. 10.0.13 is patched (MIT). -->
    <PackageVersion Include="System.Security.Cryptography.Pkcs" Version="10.0.13" />
  </ItemGroup>
  <ItemGroup Label="Api">
    <PackageVersion Include="Microsoft.AspNetCore.OpenApi" Version="10.0.13" />
  </ItemGroup>
  <ItemGroup Label="Tests">
    <PackageVersion Include="xunit.v3" Version="4.0.2" />
    <PackageVersion Include="Shouldly" Version="4.3.0" />
    <PackageVersion Include="Microsoft.AspNetCore.Mvc.Testing" Version="10.0.13" />
    <PackageVersion Include="Testcontainers.MsSql" Version="4.16.0" />
  </ItemGroup>
</Project>
